# Recommended: python3 deploy/bootstrap.py --up
# The bootstrap creates .env with a random token and never overwrites it.
# If configuring manually, generate a token with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Blank deliberately: hosted startup must fail until a real token is supplied.
APPLIED_OPT_TOKEN=
APPLIED_OPT_PUBLIC_URL=http://localhost:8787

# VPS: python3 deploy/bootstrap.py --domain opt.example.com --up
# This creates a separate .env.production and selects compose.production.yaml.
# DOMAIN=opt.example.com
